<!DOCTYPE html>
<html lang="cs">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>DOHLED // ŠPIONÁŽNÍ TERMINÁL</title>
<script src="https://cdn.jsdelivr.net/npm/@tensorflow/tfjs@4.22.0"></script>
<script src="https://cdn.jsdelivr.net/npm/@tensorflow-models/coco-ssd@2.2.3"></script>
<style>
  *{box-sizing:border-box}
  body{margin:0;background:#050805;color:#39ff6a;font-family:"Courier New",monospace;min-height:100vh;
    background-image:radial-gradient(ellipse at center,#0a140a 0%,#020302 80%)}
  header{padding:14px 18px;border-bottom:1px solid #1d4d2a;display:flex;flex-wrap:wrap;gap:10px;align-items:center;justify-content:space-between}
  h1{margin:0;font-size:18px;letter-spacing:4px;text-shadow:0 0 8px #39ff6a}
  .btns{display:flex;gap:8px;flex-wrap:wrap}
  label.btn,button{background:#0b1d10;color:#39ff6a;border:1px solid #39ff6a;padding:8px 14px;font:inherit;cursor:pointer;letter-spacing:2px;text-transform:uppercase;font-size:12px}
  label.btn:hover,button:hover{background:#39ff6a;color:#000}
  input[type=file]{display:none}
  main{display:grid;grid-template-columns:1fr 280px;gap:14px;padding:14px}
  @media(max-width:850px){main{grid-template-columns:1fr}}
  .screen{position:relative;border:1px solid #1d4d2a;background:#000;min-height:300px;display:flex;align-items:center;justify-content:center;overflow:hidden}
  canvas{max-width:100%;max-height:75vh;display:block}
  .scan{pointer-events:none;position:absolute;inset:0;background:repeating-linear-gradient(0deg,rgba(0,0,0,.28) 0 1px,transparent 1px 3px);mix-blend-mode:multiply}
  .vig{pointer-events:none;position:absolute;inset:0;box-shadow:inset 0 0 120px rgba(0,0,0,.85)}
  #caption{position:absolute;left:0;right:0;bottom:0;padding:14px 18px;background:linear-gradient(transparent,rgba(0,0,0,.92));
    color:#ff3b3b;font-size:clamp(14px,2.2vw,22px);font-weight:bold;letter-spacing:2px;text-shadow:0 0 10px #ff0000;min-height:60px}
  #caption.flash{animation:fl .5s steps(2) 3}
  @keyframes fl{50%{opacity:.2}}
  #placeholder{position:absolute;text-align:center;opacity:.7;letter-spacing:3px;line-height:2}
  aside{border:1px solid #1d4d2a;padding:12px;background:#030a04;display:flex;flex-direction:column;gap:10px}
  aside h2{margin:0;font-size:13px;letter-spacing:3px;border-bottom:1px solid #1d4d2a;padding-bottom:6px}
  #log{font-size:12px;line-height:1.6;overflow-y:auto;max-height:55vh;display:flex;flex-direction:column-reverse}
  #log div{border-left:2px solid #39ff6a;padding-left:8px;margin-bottom:6px;opacity:.85}
  #log div.warn{border-color:#ff3b3b;color:#ff7070}
  #status{font-size:12px;color:#ffd24a}
  .blink{animation:b 1s steps(2) infinite}
  @keyframes b{50%{opacity:0}}
</style>
</head>
<body>
<header>
  <h1>◉ DOHLED // TAJNÝ TERMINÁL</h1>
  <div class="btns">
    <label class="btn">Nahrát video / foto<input type="file" id="file" accept="video/*,image/*"></label>
    <button id="snd">Zvuk: ZAP</button>
  </div>
</header>
<main>
  <div class="screen" id="screen">
    <div id="placeholder">[ ČEKÁM NA VSTUPNÍ MATERIÁL ]<br>NAHRAJ VIDEO NEBO FOTOGRAFII</div>
    <canvas id="cv" width="640" height="360"></canvas>
    <div class="scan"></div><div class="vig"></div>
    <div id="caption"></div>
  </div>
  <aside>
    <h2>PROTOKOL UDÁLOSTÍ</h2>
    <div id="status">Načítám analytický modul…</div>
    <div id="log"></div>
  </aside>
</main>

<script>
const cv = document.getElementById('cv'), ctx = cv.getContext('2d');
const capEl = document.getElementById('caption'), logEl = document.getElementById('log');
const statusEl = document.getElementById('status'), ph = document.getElementById('placeholder');
const fileIn = document.getElementById('file'), sndBtn = document.getElementById('snd');

const CZ = {cup:'hrnek',bottle:'láhev','wine glass':'sklenici','cell phone':'telefon',laptop:'notebook',book:'knihu',
  knife:'nůž',scissors:'nůžky',backpack:'batoh',handbag:'kabelku',umbrella:'deštník',remote:'ovladač',
  keyboard:'klávesnici',mouse:'myš',fork:'vidličku',spoon:'lžíci',bowl:'misku',toothbrush:'kartáček',
  suitcase:'kufr',chair:'židli',couch:'gauč',tv:'televizi',bed:'postel','teddy bear':'plyšáka',
  vase:'vázu',clock:'hodiny',banana:'banán',apple:'jablko',sandwich:'sendvič',pizza:'pizzu',donut:'donut',cake:'dort'};
const CZ_CUP = {cup:'hrníček'};

let model = null, video = null, running = false, busy = false, lastDet = 0;
let persons = [], objs = [], holding = {}, prevCenter = null, stillSince = 0, personPresent = false, absentCount = 0;
let audio = null, soundOn = true, drone = null;

/* ---------- ZVUK ---------- */
function initAudio(){
  if(audio) return;
  audio = new (window.AudioContext||window.webkitAudioContext)();
  const master = audio.createGain(); master.gain.value = .5; master.connect(audio.destination);
  audio.master = master;
  drone = audio.createGain(); drone.gain.value = .06; drone.connect(master);
  const lp = audio.createBiquadFilter(); lp.type='lowpass'; lp.frequency.value=220; lp.connect(drone);
  [55,55.7,82.4].forEach(f=>{
    const o = audio.createOscillator(); o.type='sawtooth'; o.frequency.value=f; o.connect(lp); o.start();
  });
  const lfo = audio.createOscillator(), lg = audio.createGain();
  lfo.frequency.value = .12; lg.gain.value = 90; lfo.connect(lg); lg.connect(lp.frequency); lfo.start();
}
function sting(kind){
  if(!audio || !soundOn) return;
  const t = audio.currentTime, g = audio.createGain();
  g.gain.setValueAtTime(0,t); g.gain.linearRampToValueAtTime(.35,t+.05); g.gain.exponentialRampToValueAtTime(.001,t+1.8);
  g.connect(audio.master);
  const base = kind==='alert' ? 520 : 330;
  [base, base*1.0595, base*1.41].forEach((f,i)=>{
    const o = audio.createOscillator(); o.type = i? 'triangle':'sine';
    o.frequency.setValueAtTime(f,t); o.frequency.exponentialRampToValueAtTime(f*.55,t+1.6);
    const trem = audio.createOscillator(), tg = audio.createGain();
    trem.frequency.value = 7+i*2; tg.gain.value = 25; trem.connect(tg); tg.connect(o.frequency);
    o.connect(g); o.start(t); trem.start(t); o.stop(t+1.9); trem.stop(t+1.9);
  });
  // šum
  const len = audio.sampleRate*0.6, buf = audio.createBuffer(1,len,audio.sampleRate), d = buf.getChannelData(0);
  for(let i=0;i<len;i++) d[i]=(Math.random()*2-1)*(1-i/len);
  const n = audio.createBufferSource(); n.buffer = buf;
  const hp = audio.createBiquadFilter(); hp.type='highpass'; hp.frequency.value=3000;
  const ng = audio.createGain(); ng.gain.value=.08; n.connect(hp); hp.connect(ng); ng.connect(audio.master); n.start(t);
}
sndBtn.onclick = ()=>{
  initAudio(); soundOn = !soundOn;
  if(drone) drone.gain.value = soundOn ? .06 : 0;
  sndBtn.textContent = 'Zvuk: ' + (soundOn?'ZAP':'VYP');
};

/* ---------- TITULKY ---------- */
let typeTimer = null, shown = '';
function say(text, level){
  const stamp = new Date().toLocaleTimeString('cs-CZ');
  const row = document.createElement('div');
  if(level==='alert') row.className='warn';
  row.textContent = `[${stamp}] ${text}`;
  logEl.prepend(row);
  while(logEl.children.length>40) logEl.lastChild.remove();

  clearInterval(typeTimer); let i = 0; const full = '▶ ' + text.toUpperCase();
  capEl.classList.remove('flash'); void capEl.offsetWidth; capEl.classList.add('flash');
  typeTimer = setInterval(()=>{ capEl.textContent = full.slice(0,++i)+'█'; if(i>=full.length){clearInterval(typeTimer);capEl.textContent=full;} },35);
  sting(level);
}

/* ---------- LOGIKA ---------- */
const inside = (o,p)=>{
  const cx=o.bbox[0]+o.bbox[2]/2, cy=o.bbox[1]+o.bbox[3]/2, m=20;
  return cx>p.bbox[0]-m && cx<p.bbox[0]+p.bbox[2]+m && cy>p.bbox[1]-m && cy<p.bbox[1]+p.bbox[3]+m;
};
function analyze(preds, isVideo){
  persons = preds.filter(p=>p.class==='person' && p.score>.45);
  objs = preds.filter(p=>p.class!=='person' && p.score>.4);

  if(persons.length){
    absentCount = 0;
    if(!personPresent){ personPresent = true; say(persons.length>1?`V záběru se objevilo ${persons.length} osob`:'Osoba vstoupila do záběru','alert'); }
  } else if(personPresent && isVideo){
    if(++absentCount>8){ personPresent=false; holding={}; prevCenter=null; say('Osoba opustila záběr. Sleduji dál…'); }
  }
  if(!persons.length) return;

  const p = persons.reduce((a,b)=>a.bbox[2]*a.bbox[3]>b.bbox[2]*b.bbox[3]?a:b);
  const nearNow = {};
  objs.forEach(o=>{ if(inside(o,p) && CZ[o.class]) nearNow[o.class]=true; });

  if(!isVideo){
    const names = Object.keys(nearNow).map(k=>CZ_CUP[k]||CZ[k]);
    say(names.length ? `Osoba je v kontaktu s předmětem: ${names.join(', ')}` : 'Osoba zachycena. Žádný podezřelý předmět.','alert');
    return;
  }
  for(const k in nearNow){
    holding[k] = holding[k]||{n:0,on:false}; holding[k].n++;
    if(holding[k].n>=3 && !holding[k].on){ holding[k].on=true; say(`Osoba si vzala ${CZ_CUP[k]||CZ[k]}`,'alert'); }
  }
  for(const k in holding){
    if(!nearNow[k]){ holding[k].n--; if(holding[k].n<=-3){ if(holding[k].on) say(`Osoba odložila ${CZ_CUP[k]||CZ[k]}`); delete holding[k]; } }
  }

  const c = [p.bbox[0]+p.bbox[2]/2, p.bbox[1]+p.bbox[3]/2];
  if(prevCenter){
    const d = Math.hypot(c[0]-prevCenter[0], c[1]-prevCenter[1]) / (cv.width||640);
    const now = performance.now();
    if(d > .06){ stillSince = now; if(!p._fast){ say('Osoba se rychle přesouvá','alert'); } }
    else if(d < .004){ if(!stillSince) stillSince = now; if(now-stillSince>4000){ say('Osoba stojí nehybně a něco pozoruje…'); stillSince = now+999999; } }
    else stillSince = now;
  }
  prevCenter = c;
}

/* ---------- VYKRESLENÍ ---------- */
function rr(x,y,w,h,r){ctx.beginPath();ctx.moveTo(x+r,y);ctx.arcTo(x+w,y,x+w,y+h,r);ctx.arcTo(x+w,y+h,x,y+h,r);ctx.arcTo(x,y+h,x,y,r);ctx.arcTo(x,y,x+w,y,r);ctx.closePath();}
function silhouette(b,i){
  const [x,y,w,h]=b, hr=Math.min(w*.24,h*.13), cx=x+w/2;
  ctx.fillStyle='#000';
  ctx.beginPath(); ctx.ellipse(cx,y+hr,hr*.9,hr,0,0,Math.PI*2); ctx.fill();
  rr(x,y+hr*1.9,w,h-hr*1.9,Math.min(w,h)*.18); ctx.fill();
  ctx.strokeStyle='#ff2b2b'; ctx.lineWidth=2; ctx.setLineDash([8,5]); ctx.strokeRect(x-6,y-6,w+12,h+12); ctx.setLineDash([]);
  ctx.fillStyle='#ff2b2b'; ctx.font='bold 14px Courier New';
  ctx.fillText(`SUBJEKT #${i+1} // NEZNÁMÝ`, x-6, Math.max(14,y-12));
}
function hud(isVideo){
  const t = new Date();
  ctx.font='bold 15px Courier New'; ctx.fillStyle='#39ff6a';
  ctx.fillText(t.toLocaleDateString('cs-CZ')+' '+t.toLocaleTimeString('cs-CZ'), 14, 24);
  ctx.fillText('KAM-07 // NOČNÍ REŽIM', 14, 44);
  if(isVideo && Math.floor(t.getTime()/600)%2===0){ ctx.fillStyle='#ff2b2b'; ctx.beginPath(); ctx.arc(cv.width-90,20,7,0,7); ctx.fill(); ctx.fillText('REC',cv.width-76,26); }
  ctx.strokeStyle='#39ff6a'; ctx.lineWidth=2;
  [[10,10,1,1],[cv.width-10,10,-1,1],[10,cv.height-10,1,-1],[cv.width-10,cv.height-10,-1,-1]].forEach(([x,y,a,b])=>{
    ctx.beginPath(); ctx.moveTo(x,y+28*b); ctx.lineTo(x,y); ctx.lineTo(x+28*a,y); ctx.stroke(); });
}
function render(src, isVideo){
  ctx.filter='grayscale(1) contrast(1.15) brightness(.9) sepia(.3) hue-rotate(60deg)';
  ctx.drawImage(src,0,0,cv.width,cv.height); ctx.filter='none';
  persons.forEach((p,i)=>silhouette(p.bbox,i));
  hud(isVideo);
}

/* ---------- SMYČKA ---------- */
async function loop(){
  if(!running) return;
  const now = performance.now();
  if(!busy && now-lastDet>200 && !video.paused && !video.ended){
    busy = true; lastDet = now;
    model.detect(video).then(p=>{analyze(p,true);busy=false;}).catch(()=>busy=false);
  }
  render(video,true);
  requestAnimationFrame(loop);
}

fileIn.onchange = async e=>{
  const f = e.target.files[0]; if(!f) return;
  initAudio(); if(audio.state==='suspended') audio.resume();
  if(!model){ statusEl.textContent='Modul se ještě načítá, chvilku strpení…'; return; }
  running=false; persons=[]; objs=[]; holding={}; prevCenter=null; personPresent=false; absentCount=0;
  ph.style.display='none'; capEl.textContent='';
  const url = URL.createObjectURL(f);
  if(f.type.startsWith('image/')){
    const img = new Image();
    img.onload = async ()=>{
      cv.width=img.naturalWidth; cv.height=img.naturalHeight;
      statusEl.textContent='Analyzuji snímek…';
      const preds = await model.detect(img); analyze(preds,false);
      render(img,false); statusEl.textContent='Snímek analyzován.';
    }; img.src=url;
  } else {
    video = document.createElement('video'); video.src=url; video.muted=true; video.loop=true; video.playsInline=true;
    video.onloadeddata = ()=>{
      cv.width=video.videoWidth; cv.height=video.videoHeight;
      video.play(); running=true; statusEl.textContent='Sledování probíhá…'; say('Záznam spuštěn. Sleduji.'); loop();
    };
  }
};

(async()=>{
  try{
    model = await cocoSsd.load({base:'lite_mobilenet_v2'});
    statusEl.innerHTML='<span class="blink">●</span> Modul připraven. Nahraj materiál.';
  }catch(err){ statusEl.textContent='Chyba načtení modulu (potřebuješ internet).'; }
})();
</script>
</body>
</html>
