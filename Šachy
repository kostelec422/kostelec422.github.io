<!DOCTYPE html>
<html lang="cs">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Šachy online</title>
<style>
:root{box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);--bg:#f4f1ea;--fg:#222;--card:#fff;--line:#d8d2c4;--acc:#2f6f4f;--l:#ecdcb8;--d:#a97d50}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#1c1c1a;--fg:#eee;--card:#2a2a27;--line:#444;--acc:#5fb98a}}
:root[data-theme="dark"]{--bg:#1c1c1a;--fg:#eee;--card:#2a2a27;--line:#444;--acc:#5fb98a}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--fg);font-family:system-ui,-apple-system,Segoe UI,sans-serif;display:flex;flex-direction:column;align-items:center;gap:12px;padding:16px 8px}
h1{margin:0;font-size:22px}
.box{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:12px;display:flex;gap:8px;flex-wrap:wrap;justify-content:center;align-items:center}
input{font-size:16px;padding:9px 12px;border-radius:8px;border:1px solid var(--line);background:var(--bg);color:var(--fg);width:180px}
button{font-size:16px;padding:9px 16px;border-radius:8px;border:0;background:var(--acc);color:#fff;cursor:pointer}
button.sec{background:var(--line);color:var(--fg)}
#st{font-weight:600;text-align:center;min-height:24px}
#bd{--s:min(12vw,58px);display:grid;grid-template-columns:repeat(8,var(--s));border:3px solid var(--d);border-radius:4px;opacity:.5}
#bd.on{opacity:1}
.c{width:var(--s);height:var(--s);display:flex;align-items:center;justify-content:center;font-size:calc(var(--s)*.78);line-height:1;cursor:pointer;position:relative;user-select:none}
.c.l{background:var(--l)}.c.d{background:var(--d)}
.c.sel{outline:3px solid #e2b300;outline-offset:-3px}
.c.last{box-shadow:inset 0 0 0 100px rgba(255,220,0,.28)}
.c.mv::after{content:"";position:absolute;width:30%;height:30%;border-radius:50%;background:rgba(40,120,70,.55)}
.c.cap::after{width:84%;height:84%;background:none;border:4px solid rgba(200,50,50,.6)}
.w{color:#fff;text-shadow:0 0 2px #000,0 0 2px #000,0 0 2px #000}
.b{color:#111;text-shadow:0 0 1px #fff}
small{opacity:.7;text-align:center;max-width:480px}
</style>
</head>
<body>
<h1>♟ Šachy online</h1>
<div class="box" id="lobby">
  <input id="code" placeholder="Společný kód" maxlength="30" autocomplete="off">
  
